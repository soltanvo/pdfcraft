rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserCreate(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'credits', 'isPaid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'credits', 'isPaid', 'plan', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() <= 320
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.photoURL is string
        && data.photoURL.size() <= 1000
        && data.credits is int
        && data.credits == 5
        && data.isPaid is bool
        && data.isPaid == false
        && (!('plan' in data) || (data.plan is string && data.plan == 'free'))
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidUserUpdate(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'credits', 'isPaid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'credits',
          'isPaid',
          'plan',
          'subscriptionStatus',
          'paddleCustomerId',
          'paddleSubscriptionId',
          'lastOrderId',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() <= 320
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.photoURL is string
        && data.photoURL.size() <= 1000
        && data.credits is int
        && data.credits >= 0
        && data.credits <= 10000
        && data.isPaid is bool;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserCreate(incoming());
      allow update: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserUpdate(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
          || (
            incoming().diff(existing()).affectedKeys().hasOnly(['credits', 'updatedAt'])
            && (
              (existing().credits >= 1 && incoming().credits == existing().credits - 1)
              || (existing().credits >= 2 && incoming().credits == existing().credits - 2)
            )
          )
        );
      allow delete: if false;

      match /transactions/{transactionId} {
        allow get: if isValidId(userId) && isValidId(transactionId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create, update, delete: if false;
      }
    }

    match /processed_transactions/{transactionId} {
      allow read, write: if false;
    }
  }
}
