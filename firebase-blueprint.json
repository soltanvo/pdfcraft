{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "SA AI authenticated user profile, credit balance, and Paddle subscription status",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication user UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google account email",
          "maxLength": 320
        },
        "displayName": {
          "type": "string",
          "description": "Display name from Google Auth",
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "description": "Profile avatar URL",
          "maxLength": 1000
        },
        "credits": {
          "type": "integer",
          "description": "Available AI and watermark-free credits (starts at 5 free credits)"
        },
        "isPaid": {
          "type": "boolean",
          "description": "Whether user has an active paid plan (removes SA AI watermark)"
        },
        "plan": {
          "type": "string",
          "enum": ["free", "starter", "pro"],
          "description": "Active subscription tier managed via Paddle webhook"
        },
        "subscriptionStatus": {
          "type": "string",
          "enum": ["active", "canceled", "past_due", "paused"],
          "description": "Paddle subscription lifecycle status"
        },
        "paddleCustomerId": {
          "type": "string",
          "description": "Paddle customer ID",
          "maxLength": 128
        },
        "paddleSubscriptionId": {
          "type": "string",
          "description": "Paddle subscription or transaction reference ID",
          "maxLength": 128
        },
        "lastOrderId": {
          "type": "string",
          "description": "Most recent payment transaction ID applied to this account",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last account update timestamp"
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "photoURL",
        "credits",
        "isPaid",
        "createdAt",
        "updatedAt"
      ]
    },
    "CreditTransaction": {
      "title": "CreditTransaction",
      "description": "Immutable record of subscription and credit purchases for a user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderId": {
          "type": "string",
          "description": "Paddle transaction ID",
          "minLength": 3,
          "maxLength": 128
        },
        "planId": {
          "type": "string",
          "enum": ["starter", "pro"],
          "description": "Purchased plan identifier"
        },
        "creditsAdded": {
          "type": "integer",
          "description": "Number of credits added (30 or 100)"
        },
        "amountUsd": {
          "type": "number",
          "description": "USD amount paid (2 or 5)"
        },
        "status": {
          "type": "string",
          "enum": ["COMPLETED"],
          "description": "Payment completion status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Transaction timestamp"
        }
      },
      "required": [
        "userId",
        "orderId",
        "planId",
        "creditsAdded",
        "amountUsd",
        "status",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores per-user credit balance and Paddle subscription state"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/CreditTransaction"
      },
      "description": "Stores verified subscription transaction history for the owning user"
    }
  }
}
