BASE_PATH=
NEXT_PUBLIC_BASE_PATH=
APP_VERSION=
NEXT_PUBLIC_APP_VERSION=
DISABLE_UPDATE_CHECK=true
NEXT_PUBLIC_DISABLE_UPDATE_CHECK=true
TAURI_ENV=

# Firebase (Core 3 variables activate custom project; falls back to project defaults if omitted)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=

# OpenRouter AI API (Server-side only)
OPENROUTER_API_KEY=

# Paddle Billing v2 (Live Production or Sandbox; auto-detected from token prefix if omitted)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=
PADDLE_WEBHOOK_SECRET=
